{
  "name": "ai-checkin",
  "version": "1.0.8",
  "description": "AI签到管家 — 飞牛 fnOS 应用：WorkBuddy 加油站自动签到 + 通用 HTTP 签到引擎（零依赖 Node 后端 + Vue3 前端）",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "成哥哥",
  "homepage": "https://github.com/373065025/ai-checkin",
  "repository": { "type": "git", "url": "https://github.com/373065025/ai-checkin.git" },
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "node web/_build.mjs",
    "update:tgz": "node tools/build-app-tgz.js",
    "fpk": "node tools/build-fpk.js",
    "verify": "node tools/verify-fpk.js",
    "smoke": "node tools/smoke-package.js",
    "smoke:update": "node tools/smoke-update-fallback.js",
    "smoke:accounts": "node tools/smoke-multi-account.js",
    "release": "npm run build && node tools/build-app-tgz.js && node tools/build-fpk.js && node tools/verify-fpk.js"
